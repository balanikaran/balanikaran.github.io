---
import { Icon as AstroIcon } from "astro-icon/components"
import { ExternalLink } from "@lucide/astro"

const { name, size = 24 } = Astro.props

const socialIcons = {
  FaEnvelope: "social/envelope-at",
  FaGithub: "social/github",
  FaGooglePlay: "social/google-play",
  FaInstagram: "social/instagram",
  FaLinkedin: "social/linkedin",
}

const SocialIcon = socialIcons[name]
---

{
  SocialIcon ? (
    <AstroIcon name={SocialIcon} aria-hidden="true" size={size} />
  ) : (
    <ExternalLink aria-hidden="true" size={size} strokeWidth={2} />
  )
}
