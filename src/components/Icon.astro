---
import { Icon as AstroIcon } from "astro-icon/components"

const icons = {
  BsCircleHalf: "ui/circle-half",
  BsMoonStarsFill: "ui/moon-stars-fill",
  BsSunFill: "ui/sun-fill",
  FaEnvelope: "social/envelope-at",
  FaGithub: "social/github",
  FaGooglePlay: "social/google-play",
  FaInstagram: "social/instagram",
  FaLinkedin: "social/linkedin",
} as const

type IconName = keyof typeof icons

interface Props {
  name?: string
  size?: number | string
}

const { name, size = 24 } = Astro.props

const isIconName = (value: string): value is IconName =>
  Object.prototype.hasOwnProperty.call(icons, value)

const SiteIcon = name && isIconName(name) ? icons[name] : null
---

{SiteIcon && <AstroIcon name={SiteIcon} aria-hidden="true" size={size} />}
