---
import { Icon as AstroIcon } from "astro-icon/components"

const socialIcons = {
  FaEnvelope: "social/envelope-at",
  FaGithub: "social/github",
  FaGooglePlay: "social/google-play",
  FaInstagram: "social/instagram",
  FaLinkedin: "social/linkedin",
} as const

type SocialIconName = keyof typeof socialIcons

interface Props {
  name?: string
  size?: number | string
}

const { name, size = 24 } = Astro.props

const isSocialIconName = (value: string): value is SocialIconName =>
  Object.prototype.hasOwnProperty.call(socialIcons, value)

const SocialIcon = name && isSocialIconName(name) ? socialIcons[name] : null
---

{SocialIcon && <AstroIcon name={SocialIcon} aria-hidden="true" size={size} />}
