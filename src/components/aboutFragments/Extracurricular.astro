---
import { Image } from "astro:assets"
import aboutData from "../../data/about/about.json"
import { getImage } from "../../utils/images"

const extracurriculars = aboutData.extracurriculars.map(extracurricular => ({
  ...extracurricular,
  image: getImage(extracurricular.logo),
}))
---

<section
  class="extracurricularFragment"
  aria-labelledby="extracurricular-heading"
>
  <h2 id="extracurricular-heading" class="extracurricularFragHeading">
    Extracurricular <span role="img" aria-label="extracurricular">🏌</span>
  </h2>
  <div class="extracurricularGrid">
    {
      extracurriculars.map(extracurricular => (
        <article
          class="contentCard"
          aria-label={`${extracurricular.name}, ${extracurricular.role}`}
        >
          <div class="extracurricularCard">
            <div class="extracurricularCardImgDiv">
              <Image
                src={extracurricular.image}
                width={80}
                height={80}
                alt=""
              />
            </div>
            <div class="contentCardBody">
              <h3 class="extracurricularTitleText">{extracurricular.name}</h3>
              <p class="extracurricularRoleText">{extracurricular.role}</p>
              <p class="extracurricularDurationText">
                {extracurricular.duration}
              </p>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
