---
import Icon from "./Icon.astro"
import contactData from "../data/contact/contact.json"

const contacts = contactData.contacts
const contactLabels: Record<string, string> = {
  Instagram: "Karan Balani on Instagram",
  LinkedIn: "Karan Balani on LinkedIn",
  GitHub: "Karan Balani on GitHub",
  Email: "Email Karan Balani",
}
---

<section
  class="contactDiv"
  id="contactSectionId"
  aria-labelledby="contact-heading"
>
  <h2 id="contact-heading" class="contactHeading">
    Let's get connected <span role="img" aria-label="experience">🔗</span>
  </h2>
  <div class="contactSection">
    {
      contacts.map(contact => (
        <a
          target={contact.url.startsWith("mailto:") ? undefined : "_blank"}
          rel={
            contact.url.startsWith("mailto:")
              ? undefined
              : "noopener noreferrer"
          }
          href={contact.url}
          class="buttonLink buttonLinkSubtle contactButton"
          aria-label={contactLabels[contact.name] ?? contact.name}
          title={contactLabels[contact.name] ?? contact.name}
        >
          <Icon name={contact.icon} size={32} />
        </a>
      ))
    }
  </div>
</section>
