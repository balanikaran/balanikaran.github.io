---
import Navigation from "../components/Navigation.astro"
import webKb from "../images/web-kb.png"
import "../styles/index.css"

const {
  title = "Karan Balani - Backend & Infrastructure Engineer",
  description = "Backend and infrastructure engineer building observability, developer tooling, and privacy-conscious systems.",
} = Astro.props

const siteUrl = Astro.site ?? new URL(Astro.url.origin)
const homeUrl = new URL("/", siteUrl)
const canonicalUrl = new URL(Astro.url.pathname, siteUrl)
const socialImageUrl = new URL(webKb.src, siteUrl)
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${homeUrl.href}#person`,
      name: "Karan Balani",
      url: homeUrl.href,
      image: socialImageUrl.href,
      jobTitle: "Backend and Infrastructure Engineer",
      knowsAbout: [
        "Backend engineering",
        "Infrastructure",
        "Observability",
        "Developer tools",
        "Privacy-conscious systems",
      ],
      sameAs: [
        "https://www.linkedin.com/in/balanikaran",
        "https://www.github.com/balanikaran",
        "https://www.instagram.com/karanbalanii",
        "https://sevenbits.hashnode.dev/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${homeUrl.href}#website`,
      name: "Karan Balani",
      url: homeUrl.href,
      description,
      publisher: {
        "@id": `${homeUrl.href}#person`,
      },
    },
  ],
}
---

<!doctype html>
<html
  lang="en"
  data-theme="light"
  data-theme-preference="system"
  data-bs-theme="light"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      const themeStorageKey = "kb-theme"
      const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)")
      const themeChoices = ["system", "light", "dark"]

      const getStoredTheme = () => {
        try {
          const theme = localStorage.getItem(themeStorageKey)
          return themeChoices.includes(theme) ? theme : "system"
        } catch {
          return "system"
        }
      }

      const resolveTheme = preference =>
        preference === "system"
          ? mediaQuery.matches
            ? "dark"
            : "light"
          : preference

      const applyTheme = preference => {
        const theme = resolveTheme(preference)
        document.documentElement.dataset.themePreference = preference
        document.documentElement.dataset.theme = theme
        document.documentElement.dataset.bsTheme = theme
      }

      applyTheme(getStoredTheme())

      mediaQuery.addEventListener("change", event => {
        if (getStoredTheme() === "system") {
          const theme = event.matches ? "dark" : "light"
          applyTheme("system")
          window.dispatchEvent(
            new CustomEvent("kb-theme-change", {
              detail: { preference: "system", theme },
            }),
          )
        }
      })
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="@balanikaran" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href={webKb.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="balaniikaran" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta
      name="google-site-verification"
      content="QwimcVG7Pjp3RAmephvUeHDTnOTNmXC97-RNNi6ir9w"
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <div class="siteContainer">
      <Navigation />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
